[Unit]
Description=Darpan host (remote desktop)
Documentation=file:///usr/share/doc/darpan/README.md
PartOf=graphical-session.target
After=graphical-session.target darpan-net.service
Wants=darpan-net.service
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStartPre=/opt/darpan/migrate
ExecStart=/usr/bin/darpan serve
Restart=always
RestartSec=3
NoNewPrivileges=yes
# Guard rails, far above normal use (idle ~25 MB; streaming adds the CUDA context)
MemoryMax=1G
TasksMax=64

[Install]
WantedBy=graphical-session.target
