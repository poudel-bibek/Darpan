[Unit]
Description=Darpan host socket (held by systemd for the whole desktop session)
Documentation=file:///usr/share/doc/darpan/README.md
# Only while something wants it: the desktop session, or from boot, darpan-login-screen.target.
StopWhenUnneeded=yes

[Socket]
# Bound when the desktop session starts and kept while the host restarts, so no other local user can
# take the port. darpan-net (Tailscale) is bound to this unit: if the port can't be held,
# nothing is published.
ListenStream=127.0.0.1:47470
NoDelay=yes
Backlog=64
Service=darpan.service

[Install]
WantedBy=graphical-session.target
