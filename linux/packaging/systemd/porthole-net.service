[Unit]
Description=Porthole private network (bundled Tailscale, userspace, no root)
Documentation=https://tailscale.com/kb/1112/userspace-networking
StartLimitIntervalSec=0

[Service]
Type=simple
Environment=TS_LOGS_DIR=%h/.local/share/porthole/tailscale
ExecStartPre=/usr/bin/mkdir -p %t/porthole %h/.local/share/porthole/tailscale
ExecStart=/opt/porthole/tailscale/tailscaled --tun=userspace-networking --statedir=%h/.local/share/porthole/tailscale --socket=%t/porthole/tailscaled.sock --port=0 --no-logs-no-support
Restart=always
RestartSec=3
NoNewPrivileges=yes

[Install]
WantedBy=default.target
