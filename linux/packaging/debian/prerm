#!/bin/sh
set -e
each_user() {
    for uid in $(loginctl list-users --no-legend 2>/dev/null | awk '{print $1}'); do
        [ "$uid" -ge 1000 ] 2>/dev/null || continue
        user=$(id -nu "$uid" 2>/dev/null) || continue
        systemctl --user -M "$user@" "$@" >/dev/null 2>&1 || true
    done
}
case "$1" in
remove|deconfigure)
    each_user stop darpan-login-screen.target darpan.service darpan-net.service darpan.socket
    systemctl --global disable darpan.service darpan-net.service darpan.socket darpan-login-screen.target \
        darpan-desktop.service >/dev/null 2>&1 || true
    [ "$1" = remove ] && /opt/darpan/login-screen-setup remove || true    # linger, GDM's Xorg setting
    ;;
esac
find /opt/darpan -name __pycache__ -type d -prune -exec rm -rf {} + 2>/dev/null || true
exit 0
