#!/bin/sh
set -e
each_user() {  # run "$@" as the systemd user manager of every logged-in user
    for uid in $(loginctl list-users --no-legend 2>/dev/null | awk '{print $1}'); do
        [ "$uid" -ge 1000 ] 2>/dev/null || continue
        user=$(id -nu "$uid" 2>/dev/null) || continue
        systemctl --user -M "$user@" "$@" >/dev/null 2>&1 || true
    done
}
case "$1" in
configure)
    python3 -m compileall -q -f /opt/darpan/host >/dev/null 2>&1 || true
    systemctl --global enable darpan-net.service darpan.service >/dev/null 2>&1 || true
    each_user daemon-reload
    each_user restart darpan-net.service
    each_user restart darpan.service
    echo
    echo "  Darpan is installed."
    echo "  Finish setup: open \"Darpan\" from your apps, or run:  darpan setup"
    echo
    ;;
esac
exit 0
